  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom pathlib import Path\nDATA_PATH=Path('../../data/ensanut_integrated.csv'); RESULTS_DIR=Path('./results'); RESULTS_DIR.mkdir(exist_ok=True)\ndf=pd.read_csv(DATA_PATH,low_memory=False)\ndef num(s): return pd.to_numeric(s.astype('string').str.replace(',','.',regex=False).str.strip(),errors='coerce')\nfor c in ['EDAD','ENT','REGION','SEXO','P8_9','WEIGHT_FINAL','HEIGHT_FINAL','FACTOR','FACTOR_EXPANSION']:\n    if c in df: df[c]=num(df[c])\nstate_mapping={1:'Aguascalientes',2:'Baja California',3:'Baja California Sur',4:'Campeche',5:'Coahuila',6:'Colima',7:'Chiapas',8:'Chihuahua',9:'Ciudad de México',10:'Durango',11:'Guanajuato',12:'Guerrero',13:'Hidalgo',14:'Jalisco',15:'Estado de México',16:'Michoacán',17:'Morelos',18:'Nayarit',19:'Nuevo León',20:'Oaxaca',21:'Puebla',22:'Querétaro',23:'Quintana Roo',24:'San Luis Potosí',25:'Sinaloa',26:'Sonora',27:'Tabasco',28:'Tamaulipas',29:'Tlaxcala',30:'Veracruz',31:'Yucatán',32:'Zacatecas'}\nregion_mapping={1:'Norte',2:'Centro',3:'Ciudad de México',4:'Sur'}\nassert set(df.ENT.dropna().astype(int)).issubset(state_mapping), 'Undocumented ENT code found'\nassert set(df.REGION.dropna().astype(int)).issubset(region_mapping), 'Undocumented REGION code found'\ndf['Estado']=df.ENT.map(state_mapping); df['Region_Name']=df.REGION.map(region_mapping)\ndf=df[df.EDAD.ge(20)].copy()\nif 'P8_9' in df:\n    women=df.SEXO.eq(2); print(f'Pregnancy missing among women: {df.loc[women,"P8_9"].isna().mean():.1%}'); df=df.loc[~(df.SEXO.eq(2)&df.P8_9.eq(1))]\ndf['BMI']=df.WEIGHT_FINAL/(df.HEIGHT_FINAL/100)**2\ndf.loc[~(df.BMI.between(10,60)&df.HEIGHT_FINAL.between(100,250)&df.WEIGHT_FINAL.between(25,250)),'BMI']=np.nan\nweight=next((c for c in ['FACTOR','FACTOR_EXPANSION'] if c in df and df[c].gt(0).any()),None)\nsummary=df.groupby('Region_Name').agg(N=('BMI','count'),BMI_mean=('BMI','mean'),BMI_sd=('BMI','std')).round(2)\nif weight:\n    def wm(g):\n        x=g[['BMI',weight]].dropna(); return np.average(x.BMI,weights=x[weight]) if len(x) else np.nan\n    summary['BMI_weighted_mean']=df.groupby('Region_Name').apply(wm,include_groups=False).round(2)\nprint(summary); print('Weight:',weight or 'none; unweighted only'); summary.to_csv(RESULTS_DIR/'eda_region_summary.csv')\n"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["plot_df=df.dropna(subset=['BMI','Region_Name']); sns.violinplot(data=plot_df,x='Region_Name',y='BMI',hue='Region_Name',legend=False); plt.title('BMI by region (canonical WEIGHT_FINAL/HEIGHT_FINAL)'); plt.show()\n"]},
